{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "owner": {
      "type": "string",
      "enum": [
        "Michał Wanielista"
      ]
    },
    "decisions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUPERSEDED"
            ]
          },
          "decision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "maxItems": 1000
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "location": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            },
            "required": [
              "location",
              "locator"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "status",
          "decision",
          "rationale",
          "supersedes",
          "source",
          "date"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "owner",
    "decisions"
  ]
}
